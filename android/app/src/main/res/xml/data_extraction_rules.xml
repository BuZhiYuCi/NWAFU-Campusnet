<?xml version="1.0" encoding="utf-8"?>
<!--
  凭据类应用不应参与云备份或换机迁移：
  Keystore 里的密钥与设备绑定，备份出去的密文在新设备上根本解不开，
  用户会看到"密码莫名其妙丢了"，反而不如一开始就不备份。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
